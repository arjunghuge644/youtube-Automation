# Copy to .env in the repository root. Never commit real credentials.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
APP_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/creatorflow
REDIS_URL=redis://127.0.0.1:6379
SESSION_TTL_HOURS=24
TRUST_PROXY=false
# Omit COOKIE_SECURE to use false in development and true in production.
# COOKIE_SECURE=false

# Google Gemini API & Model Configuration
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Compose only. Keep localhost aligned with the URL used in your browser.
WEB_PORT=8080
MONGO_PORT=27017
REDIS_PORT=6379
COMPOSE_APP_ORIGIN=http://localhost:8080
COMPOSE_COOKIE_SECURE=false
