{
  "name": "creatorflow-ai-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {"node": ">=22.12.0", "npm": ">=10"},
  "scripts": {
    "dev": "npm run build -w @creatorflow/shared && concurrently -k -n api,web 'npm run dev -w @creatorflow/api' 'npm run dev -w @creatorflow/web'",
    "build": "npm run build -w @creatorflow/shared && npm run build -w @creatorflow/api && npm run build -w @creatorflow/web",
    "typecheck": "npm run build -w @creatorflow/shared && npm run typecheck -w @creatorflow/api && npm run typecheck -w @creatorflow/web",
    "test": "npm run build -w @creatorflow/shared && vitest run",
    "test:e2e": "playwright test",
    "services:up": "docker compose up -d mongo redis",
    "services:down": "docker compose stop mongo redis",
    "services:local": "node scripts/local-services.mjs",
    "render:demo": "tsx scripts/render-demo.ts",
    "check:environment": "node scripts/check-environment.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "mongodb-memory-server": "^10.3.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "5.0.5"
  },
  "config": {"mongodbMemoryServer": {"disablePostinstall": true, "version": "8.0.34", "downloadDir": ".cache/mongodb", "preferGlobalPath": false}}
}
